MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ENDPOINT=/mcp
MCP_AUTH_ENABLED=false
# Set a value of at least 16 characters before enabling authentication.
MCP_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUEST_BODY_LIMIT=1048576
REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info
