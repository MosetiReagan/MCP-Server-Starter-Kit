{
  "name": "mcp-server-starter-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready starter kit for building MCP servers that connect AI agents to APIs, databases, and custom tools.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @mcp-starter/server",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "@fastify/cors": "11.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.3",
    "ioredis": "5.11.1",
    "mysql2": "3.24.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "undici": "7.29.1",
    "zod": "4.6.1"
  }
}
